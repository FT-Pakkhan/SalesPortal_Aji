<?xml version="1.0" encoding="UTF-8"?>
<!--
  AJI Sales Portal - IIS in front of the portal (HTTPS). Needs the IIS modules "URL Rewrite" and
  "Application Request Routing" (ARR) with its proxy switched on (IIS Manager > server > Application Request
  Routing Cache > Server Proxy Settings > Enable proxy). See the Deployment Guide.
  The site's folder only holds this file; the portal itself runs on http://127.0.0.1:3000 (PORT in portal.env).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Let's Encrypt (win-acme) checks files in this folder: served by IIS, not redirected or forwarded -->
        <rule name="ACME challenge" stopProcessing="true">
          <match url="^\.well-known/acme-challenge/" />
          <action type="None" />
        </rule>
        <!-- http:// -> https:// (GPS check-in only works over HTTPS) -->
        <rule name="Redirect to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <!-- Everything else to the portal -->
        <rule name="AJI Sales Portal" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <!-- Attachments: up to 100 MB (the portal's own limit is Max. File Size in General Settings) -->
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>
    <!-- The portal's own error pages and messages reach the browser as they are -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
