# ============================================================================================================
# AJI Sales Portal - server settings
# Copy this file to "portal.env" (same folder) and fill in the values below. portal.env holds passwords: keep it
# private (only administrators and the account that runs the portal should be able to read it).
# No spaces around "=". Quotes are not needed. Restart the portal after a change.
# ============================================================================================================

# ---- SQL Server ----
# Server name, or name\instance. The login must be able to read the company list database below.
DB_SERVER=SQLSERVERNAME
DB_USER=
DB_PASSWORD=

# ---- Company list ----
# The database with the ODBC table (database\common\001_create_odbc.sql): one row per company, shown at login.
# Each company's SAP database is the SAP Database in its own General Settings.
DB_COMMON=Portal_Sales_COMMON

# ---- Secrets: run scripts\new-secrets.ps1 for new values ----
# Login tokens: a long random text (at least 32 characters)
JWT_SECRET=
# Encrypts the SAP and SMTP passwords saved in General Settings. If a company database was copied from another
# PC, use the SAME value as that PC, otherwise its saved passwords must be keyed in again in General Settings.
SETTINGS_SECRET_KEY=

# ---- Only if you need to change them (remove the # in front). The values shown are the defaults. ----
# SQL Server port
#DB_PORT=1433
# How long a login lasts
#JWT_EXPIRES_IN=8h
# Where the portal listens. 127.0.0.1 = only this server (IIS in front); 0.0.0.0 = every computer can reach
# http://SERVER:PORT directly (no HTTPS - GPS check-in won't work)
#PORT=3000
#HOSTNAME=127.0.0.1
